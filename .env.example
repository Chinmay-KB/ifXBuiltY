# Copy to `.env.local` (or set the same names in Vercel → Project → Settings → Environment Variables).
# @see https://supabase.com/docs/guides/getting-started/api-keys

NEXT_PUBLIC_SUPABASE_URL=
# New projects: publishable key. Legacy: use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (later: admin operations, bypass RLS — never expose to the client)
# SUPABASE_SECRET_KEY=

# OpenAI Image API (generation — add when implementing /api/generate)
# OPENAI_API_KEY=
