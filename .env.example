# Copy to `.env.local` (or set the same names in Vercel → Project → Settings → Environment Variables).
# @see https://supabase.com/docs/guides/getting-started/api-keys

NEXT_PUBLIC_SUPABASE_URL=
# New projects: publishable key. Legacy: use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Dashboard → Authentication → URL Configuration:
# - Site URL: http://localhost:3000 (production: your real origin)
# - Additional redirect URLs: http://localhost:3000/auth/callback
# Google Cloud Console → OAuth client → Authorized redirect URIs must include
#   https://<project-ref>.supabase.co/auth/v1/callback
# Then Dashboard → Authentication → Providers → Google: paste Web client ID + secret.

# Server-only (later: admin operations, bypass RLS — never expose to the client)
# Prefer naming this `SUPABASE_SERVICE_ROLE_KEY` locally; both names are supported by the codebase.
# Get it from Supabase Dashboard → Project Settings → API → Project API keys → `service_role` (secret).
# SUPABASE_SERVICE_ROLE_KEY=
# Legacy alias (also supported)
# SUPABASE_SECRET_KEY=

# Supabase Storage bucket id (see supabase/migrations/*storage*.sql)
# GENERATION_IMAGES_BUCKET=generation-images

# Vercel AI Gateway — `POST /api/generate`, `yarn ai:image`, etc.
# Use AI_GATEWAY_API_KEY locally/CI, or VERCEL_OIDC_TOKEN (`vercel env pull`) on Vercel.
# AI_GATEWAY_API_KEY=
# Optional override (default: openai/gpt-image-2)
# AI_GATEWAY_IMAGE_MODEL=


# Dodo Payments — server-only
# Obtain from Dodo Dashboard → Developers → API Keys
DODO_PAYMENTS_API_KEY=
# Webhook secret from the webhook you configure in Dodo Dashboard
DODO_PAYMENTS_WEBHOOK_KEY=
# Optional: 'test_mode' or 'live_mode'. Defaults to 'test_mode' in dev and 'live_mode' in prod if unset.
# DODO_ENV=test_mode
# Credit Entitlement ID for "Image Credits" (Dashboard → Credit Entitlements)
DODO_IMAGE_CREDITS_ENTITLEMENT_ID=
# Public (client-visible): the Dodo Product ID for your credit pack checkout button.
# This is safe to expose; it’s only used to initiate a hosted checkout session server-side.
NEXT_PUBLIC_DODO_IMAGE_CREDITS_PRODUCT_ID=
# Optional default return URL for hosted checkout (you can also pass per-request)
# DODO_PAYMENTS_RETURN_URL=
